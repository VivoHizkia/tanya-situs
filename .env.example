# LLM provider. Any OpenAI-compatible endpoint works; the default is Gemini.
# A free key is available at https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
# Used only when LLM_MODEL keeps answering "busy" (429/503). Leave empty to disable.
LLM_FALLBACK_MODEL=

# Public address of this app, used in the embed code shown to customers.
# Leave empty to use the address the dashboard is opened on.
APP_URL=

# Postgres connection string (Supabase, Neon, or your own server).
# Leave empty in development: an embedded Postgres is stored in .data/ instead.
DATABASE_URL=
# Optional: the database provider's root certificate (PEM, line breaks written as 
).
# When set, leave sslmode out of DATABASE_URL.
DATABASE_CA=

# Set to "false" to stop new accounts from being created.
SIGNUPS_OPEN=true

# Where "Upgrade" and "Contact" links on the site point, e.g. mailto:you@example.com
CONTACT_URL=
